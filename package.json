{
  "name": "meowcoin-stratum",
  "version": "2.0.1",
  "description": "Meowcoin (MEWC) solo-mining stratum server — auto-setup wizard, live web dashboard, single binary. MeowPoW. APEX/legacy consensus.",
  "main": "index.js",
  "bin": {
    "meowsolo": "bin/meowsolo.js"
  },
  "author": "JustAResearcher",
  "contributors": [
    "The Labyrinth Core developers (upstream kawpow-stratum)"
  ],
  "license": "MIT",
  "dependencies": {
    "@mintpond/hasher-kawpow": "git+https://github.com/LabyrinthCore/kawpow-hasher",
    "@mintpond/mint-bitcoin-script": "git+https://github.com/MintPond/mint-bitcoin-script",
    "@mintpond/mint-bos": "git+https://github.com/MintPond/mint-bos",
    "@mintpond/mint-merkle": "git+https://github.com/MintPond/mint-merkle",
    "@mintpond/mint-precon": "git+https://github.com/MintPond/mint-precon",
    "@mintpond/mint-socket": "git+https://github.com/MintPond/mint-socket",
    "@mintpond/mint-utils": "git+https://github.com/MintPond/mint-utils",
    "exceljs": "^4.4.0",
    "sha3": "2.1.4"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@yao-pkg/pkg": "^6.19.0"
  },
  "scripts": {
    "start": "node bin/meowsolo.js",
    "build:win": "pkg . --targets node22-win-x64 --output dist/meowsolo.exe",
    "build:linux": "pkg . --targets node22-linux-x64 --output dist/meowsolo"
  },
  "pkg": {
    "scripts": [
      "libs/**/*.js",
      "bin/**/*.js"
    ],
    "assets": [
      "node_modules/@mintpond/hasher-kawpow/build/Release/kawpowhasher.node",
      "node_modules/bindings/**/*.js",
      "libs/dashboard/public/**/*"
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/JustAResearcher/Meowcoin-Stratum.git"
  }
}
